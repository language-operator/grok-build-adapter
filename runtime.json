{
  "schemaVersion": 1,
  "name": "grok-build",
  "displayName": "grok-build",
  "role": "main",
  "requires": { "codingRuntime": ">=0.1.6 <1.0.0" },
  "env": { "GROK_HOME": "${STATE_DIR}/grok" },
  "preflight": [{ "path": "${STATE_DIR}/grok", "mode": "700" }],
  "config": { "emitter": { "type": "module", "path": "/opt/adapter/emit.mjs" } },
  "serve": { "surface": "terminal", "port": 8080, "originGuard": true },
  "terminal": {
    "tmuxSession": "grok-build",
    "launch": ["launch-grok-build"],
    "cwd": "${WORKDIR}",
    "wsPath": "/ws",
    "keepaliveSeconds": 25
  },
  "task": { "exec": ["launch-grok-build-task"] }
}
